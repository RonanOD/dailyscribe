# ---- DailyScribe environment ----
# Copy to .env.local (in apps/web) for local dev, and set these in Vercel for prod.
# NEVER commit real values. Placeholders only.

# MongoDB Atlas — dedicated DailyScribe project / free M0 cluster
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="dailyscribe"

# AES-256-GCM key for encrypting per-user secrets at rest (32 random bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Auth.js (NextAuth v5)
# Generate AUTH_SECRET: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
# GitHub OAuth app — callback URL: https://dailyscribe.ca/api/auth/callback/github
AUTH_GITHUB_ID="REPLACE"
AUTH_GITHUB_SECRET="REPLACE"
# Signups are paused while the app is pre-launch: only emails already in the
# "users" collection can sign in. Set to "true" to let anyone sign up again.
ALLOW_NEW_SIGNUPS="false"

# Vercel Cron guard — cron requests must send Authorization: Bearer ${CRON_SECRET}
# Generate: openssl rand -hex 32
CRON_SECRET="REPLACE_WITH_RANDOM_HEX"

# Resend — app-wide outbound email from the verified dailyscribe.ca domain.
# Users whitelist this ONE address in their Kindle's Approved Personal Document E-mail List.
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
MAIL_FROM_DEFAULT="Daily Scribe <my@dailyscribe.ca>"

# Resend Receiving — one shared inbound address for all mailed-back
# submissions, across every service (apps/web/app/api/webhooks/resend-inbound).
# Routing is done via metadata embedded in the PDF itself (its /Subject field,
# "dailyscribe:<service>:<token>"), not via the address, so the address is
# just reply@<domain> for everyone. On a subdomain (my.dailyscribe.ca), not
# the root domain — the root already has an active Cloudflare Email Routing
# rule (my@dailyscribe.ca forwards to a personal inbox) that inbound
# receiving's MX records would conflict with.
# Setup: enable Receiving for the subdomain in the Resend dashboard, add the
# MX record(s) it issues at the DNS host (Cloudflare), create a webhook
# subscribed to "email.received" pointed at
# https://dailyscribe.ca/api/webhooks/resend-inbound, and copy its signing secret.
RESEND_INBOUND_WEBHOOK_SECRET="REPLACE_WITH_RESEND_WEBHOOK_SIGNING_SECRET"
RESEND_INBOUND_DOMAIN="my.dailyscribe.ca"

# Google Gemini — vision check for the Kanji handwriting check-in (grades a mailed-back
# practice page against the batch of kanji it was sent for). Get a key at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
# Optional model override — defaults to "gemini-flash-lite-latest" (Google's self-updating
# alias for the current cheapest/fastest Flash-Lite model) if unset.
GEMINI_MODEL=""
