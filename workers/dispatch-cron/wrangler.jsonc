{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cron-only Worker: pings Daily Scribe's dispatch endpoint every 10 minutes.
  // See src/index.ts for why this exists.
  "name": "dailyscribe-dispatch-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No public URL; the only entry point is the cron trigger.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "DISPATCH_URL": "https://my.dailyscribe.ca/api/cron/dispatch"
  },
  // CRON_SECRET is a Worker secret: `pnpm wrangler secret put CRON_SECRET`.
  "observability": { "enabled": true }
}
